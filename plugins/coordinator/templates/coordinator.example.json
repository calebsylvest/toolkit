{
  "owner": "<owner>",
  "coordinator": "<coordinator>",
  "agents": [
    { "name": "<agent-name>", "repo": "~/Code/<repo>", "bot": "<bot-name>" },
    { "name": "<other-agent>", "repo": "~/Code/<other-repo>", "bot": null, "stall_hours": 72 }
  ],
  "orchestrator": {
    "type": "orca",
    "bots": ["<coordinator>", "<setup-bot>", "<bot-name>"]
